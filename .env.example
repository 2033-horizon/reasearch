# ============================================================
#  环境配置模板 —— 复制为 .env 后填写
#    Windows:  copy .env.example .env
#    macOS/Linux:  cp .env.example .env
# ============================================================
# 本项目默认形态（国内网络直连）：
#   · 大模型  → OpenAI 兼容网关（用 openai: 前缀接入）
#   · 搜索    → 博查 BoCha（国内中文搜索 API）
#   · 向量化  → 阿里百炼 DashScope（DeepSeek 无 embedding 接口）
#
# 【必填 1、2、3】缺一不可；【必填 4】已给默认值。
# 证据层与裁决开关在文件末尾，本项目的核心功能，建议保持开启。


# ------------------------------------------------------------
# 【必填 1】大模型
# ------------------------------------------------------------
# 为什么用 openai: 前缀而不是 deepseek: 前缀？
#   代码中 deepseek: 这个 provider 的 base_url 硬编码为
#   https://api.deepseek.com（gpt_researcher/llm_provider/generic/base.py），
#   无法指向网关；而 openai: 会读取 OPENAI_BASE_URL，正是网关/自建
#   兼容接口应该用的方式。
# 模型名请以网关文档或 <网关地址>/v1/models 返回的为准。
FAST_LLM=openai:deepseek-chat
SMART_LLM=openai:deepseek-chat
STRATEGIC_LLM=openai:deepseek-chat

# OpenAI 兼容地址，必须以 /v1 结尾。
# 例：公司网关 https://<your-gateway>/v1；直连官方 https://api.deepseek.com/v1
OPENAI_BASE_URL=
# 对应密钥（通常 sk- 开头）
OPENAI_API_KEY=

# 请求超时（秒）。网关对同 key 并发有限制时，超时要留足余量，
# 避免"排队 → 超时 → 重试 → 再排队"的空转。
LLM_KWARGS={"request_timeout": 300}

# 如果你的网关要求额外请求头（多数不需要）：
# LLM_KWARGS={"request_timeout": 300, "default_headers": {"X-Api-Key": "xxx"}}


# ------------------------------------------------------------
# 【必填 2】搜索引擎 (Retriever)
# ------------------------------------------------------------
# 博查 BoCha：国内中文搜索 API，原生支持中文。
# 注册地址：https://open.bochaai.com
RETRIEVER=bocha
BOCHA_API_KEY=

# 备选方案 A：Tavily（效果好，需要能访问外网）
# RETRIEVER=tavily
# TAVILY_API_KEY=

# 备选方案 B：DuckDuckGo（免费无需 key，国内直连不稳）
# RETRIEVER=duckduckgo


# ------------------------------------------------------------
# 【必填 3】Embedding 向量模型
# ------------------------------------------------------------
# DeepSeek 没有 embedding 接口，因此这一项必须单独配置。
# 阿里百炼注册地址：https://bailian.console.aliyun.com
EMBEDDING=dashscope:text-embedding-v4
DASHSCOPE_API_KEY=


# ------------------------------------------------------------
# 【必填 4】报告输出语言
# ------------------------------------------------------------
# 只控制最终报告正文语言，不影响搜索关键词。
LANGUAGE=Simplified Chinese


# ============================================================
#  抓取与输出（一般不用改）
# ============================================================

# 本地文档模式的数据目录
DOC_PATH=./my-docs

# 抓取并发数。默认 15，中文站点建议降到 8 以避免被封。
MAX_SCRAPER_WORKERS=8

# 搜索 API 限流间隔（秒）。博查免费版建议设 1.0，付费版可设 0。
SCRAPER_RATE_LIMIT_DELAY=0

# 输出 token 上限。推理模型会把"思考" token 计入输出上限，
# 证据抽取（走 fast 档）这类复杂任务容易把额度烧在思考上导致空响应，
# 故建议调大 fast 额度。
FAST_TOKEN_LIMIT=16000
# SMART_TOKEN_LIMIT=12000
# STRATEGIC_TOKEN_LIMIT=8000


# ============================================================
#  证据层（阶段一：来源分级 + 证据抽取）
# ============================================================
# 总开关：抓取到的来源 → 来源档案（A-D 评级）+ 结构化证据条目
# （指标、数值、口径、原文引用）。由顶层研究者在研究完成后自动触发，
# 子研究者不重复触发。关闭时现有研究行为与产物完全不变。
EVIDENCE_EXTRACTION_ENABLED=true

# 抽取/评级所用 LLM 档位：fast | smart（默认 fast 省钱，质量不够可改 smart）
EVIDENCE_LLM=fast

# 抽取并发的 LLM 调用数上限。网关限制同 key 并发时（实测约 2），
# 调大只会排队，建议与网关并发能力一致。
EVIDENCE_CONCURRENCY=2

# 其余参数保持默认即可：
# EVIDENCE_MAX_SOURCES=100              # 单次研究处理来源数上限
# EVIDENCE_MAX_CHARS_PER_SOURCE=30000   # 每个来源正文截断长度（字符）
# EVIDENCE_CHUNK_SIZE=8000              # 抽取分块大小（字符）
# EVIDENCE_CHUNK_OVERLAP=400            # 分块重叠（字符）
# RELIABILITY_RULES_PATH=               # 空 = 使用包内默认分级规则表
# TIER_CACHE_PATH=data/tier_cache.json  # LLM 兜底评级缓存（候选规则池）


# ============================================================
#  裁决与复核（阶段二：聚类 → 裁决 → 复核 → 证据驱动报告）
# ============================================================
# 开启后：同一指标的跨来源证据 → 证据组 → 裁决（采纳 / 交叉验证通过 /
# 冲突待审 / 证据不足待审）；报告正文只用有效结论，Word 带真脚注；
# 证据落 SQLite；例外项在复核页面处置后可重生成报告。
ADJUDICATION_ENABLED=true

# 指标归并 / 口径判定所用 LLM 档位：fast | smart
ADJUDICATION_LLM=fast

# 待审证据组是否阻塞报告正文：false = 不阻塞，待审只进报告附录（推荐）
ADJUDICATION_PENDING_BLOCKS_REPORT=false

# 其余参数保持默认即可：
# ADJUDICATION_RULES_PATH=              # 空 = 使用包内默认裁决策略表
# EVIDENCE_DB_PATH=data/evidence.db     # SQLite 证据库路径（置空则不落库）
# REPORT_PENDING_APPENDIX=true          # 待审清单默认列入报告附录


# ============================================================
#  可选
# ============================================================

# LangSmith 追踪（可选）
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT="gpt-researcher"

# 允许抓取内网/回环/云元数据地址（默认拦截；仅在明确调研内部站点时开启）
# ALLOW_PRIVATE_URLS=true

# FireCrawl 抓取并发（免费版仅 2，付费版可调大）
# FIRECRAWL_CONCURRENCY=2
